# Rootfs des Pi-Agenten (pi.dev). node:20-slim = Debian/glibc -> pi (npm) laeuft
# sauber, inkl. gebundeltem ripgrep. python3 fuer die Bridge.
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git ripgrep python3 iproute2 iputils-ping nfs-common \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @earendil-works/pi-coding-agent \
    && npm cache clean --force

COPY pi_bridge.py    /app/pi_bridge.py
COPY webterm.py      /app/webterm.py
COPY config-pi.env   /app/config.env
COPY guest-init-pi.sh /init
# Agent laeuft als 'node' (uid 1000) — CLI-Agenten laufen nicht gern als root
RUN chmod +x /init && mkdir -p /home/node/.config /home/node/workspace \
    && chown -R node:node /home/node
