# Konfiguration der Bridge IM Gast (wird von guest-init.sh exportiert).
SIGNAL_API=https://signal-api.example.com
SIGNAL_VERIFY=true
SIGNAL_NUMBER=
# Direkt-Chat: nur diese Nummer(n) duerfen steuern (Trust-Boundary!)
ALLOWED_SENDERS=
# Arbeitsverzeichnis IN der VM (agent laeuft als node) = NFS-Mount von /home/ulrich/agent
CLAUDE_WORKDIR=/home/node/workspace
# NFS-Agent-Ordner vom Host live einbinden (1=an). Host = Default-Gateway.
# Der Host exportiert /home/ulrich/agent als NFSv4-Root (fsid=0) -> Gast mountet ":/".
AGENT_NFS=1
AGENT_EXPORT=/
ALLOW_ACTIONS=true
CLAUDE_TIMEOUT=900
