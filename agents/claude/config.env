# Configuration of the bridge IN the guest (exported by guest-init.sh).
SIGNAL_API=https://signal-api.example.com
SIGNAL_VERIFY=true
SIGNAL_NUMBER=
# Direct chat: only this/these number(s) may command (trust boundary!)
ALLOWED_SENDERS=
# Working directory IN the VM (agent runs as node) = NFS mount of /home/ulrich/agent
CLAUDE_WORKDIR=/home/node/workspace
# Mount the NFS agent folder from the host live (1=on). Host = default gateway.
# The host exports /home/ulrich/agent as NFSv4 root (fsid=0) -> guest mounts ":/".
AGENT_NFS=1
AGENT_EXPORT=/
ALLOW_ACTIONS=true
CLAUDE_TIMEOUT=900
# The agent (node) cannot write the root-owned global npm tree: no self-update
# attempts in the VM — a new Claude Code comes with a rebuilt image.
DISABLE_AUTOUPDATER=1
