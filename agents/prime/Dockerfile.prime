# Rootfs des Prime-Agenten (primeintellect.ai). node:24-slim = node/npm (prime-agent
# ist ein npm-Paket) + python3/pip fuer den IPython-Kernel des Agenten. Bridge = python3.
FROM node:24-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git ripgrep curl python3 python3-pip iproute2 iputils-ping nfs-common \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages ipython ipykernel \
    && curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh \
    && npm cache clean --force

COPY prime_bridge.py     /app/prime_bridge.py
COPY webterm.py          /app/webterm.py
COPY config-prime.env    /app/config.env
COPY guest-init-prime.sh /init
# Agent laeuft als 'node' (uid 1000) — CLI-Agenten laufen nicht gern als root.
RUN chmod +x /init && mkdir -p /home/node/.config /home/node/.prime /home/node/workspace \
    && chown -R node:node /home/node
