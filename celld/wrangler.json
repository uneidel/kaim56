{
  "name": "kaim56-apps",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "main": "worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEFLOW",
        "class_name": "CodeflowState"
      },
      {
        "name": "COREWAR",
        "class_name": "CorewarLog"
      },
      {
        "name": "AGENTS",
        "class_name": "AgentState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodeflowState"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CorewarLog"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AgentState"
      ]
    }
  ],
  "vars": {
    "LLM_URL": "http://172.17.0.1:8700/api/llm/openrouter/chat/completions",
    "DEFAULT_MODEL": "google/gemini-2.5-flash"
  }
}
