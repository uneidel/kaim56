{
  "name": "kaim56-apps",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "main": "worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEFLOW",
        "class_name": "CodeflowState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodeflowState"
      ]
    }
  ]
}
