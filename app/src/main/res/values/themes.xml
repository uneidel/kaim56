<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The prototype is drawn dark only (#0E1218). Window and status-bar
         backgrounds are pinned to it, otherwise the light Material background
         flashes through at startup. -->
    <style name="Theme.KatAgent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/kat_bg</item>
        <item name="android:statusBarColor">@color/kat_bg</item>
        <item name="android:navigationBarColor">@color/kat_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
