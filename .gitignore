# Achtung: .gitignore kennt KEINE Kommentare am Zeilenende — ein "# …" hinter
# dem Muster wird Teil des Musters und die Regel greift nie. Kommentare stehen
# darum immer in eigenen Zeilen.

# --- Laufzeit & Daten: gehoeren auf den Host, nie ins Repo -------------------
# API-Keys (0600)
manager/settings.json
# Standort-Config (Domains/IPs/Interface) -> examples/site.example.json
manager/site.json
# MCP-Katalog mit echten LAN-Endpunkten -> examples/mcp-catalog.example.json
manager/mcp-catalog.json
# Chat-Verlauf, Aufgaben, Gedaechtnis, Wasserzeichen
manager/chats.json
manager/chats_tombstones.json
manager/tasks.json
manager/memory.json
manager/inbox_wm.json
# Aufgaben-History inkl. SQLite-WAL-Sidecars (-wal/-shm)
manager/history.db*
# Befunde ueber die eigene Installation
manager/security.json
# enthaelt den basicAuth-Hash -> examples/traefik-agents.example.yml
manager/traefik-agents.yml
manager/audit/
manager/run/
manager/instances/
manager/bin/

# --- Build-Artefakte ---------------------------------------------------------
__pycache__/
*.pyc
*.bak-*
app/app/build/
app/build/
app/.gradle/
app/dist/
local.properties
katfs/**/target/
katfs/dist/
*.log

# --- Nichts Grosses und nichts Geheimes --------------------------------------
# Releases gehoeren an die Gitea-Releases
*.apk
# rootfs-Images (GB-Bereich) und Kernel werden gebaut, nicht versioniert
*.ext4
vmlinux
# Signaturschluessel der App
app/keystore/
# iroh-Node-Identitaet (katfs)
secret.key
*.jks
*.p12
