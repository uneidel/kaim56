{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kAIm56",
  "version": "0.1.0",
  "identifier": "de.kat56.kaim56.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "kAIm56", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
